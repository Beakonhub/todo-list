# Postgres connection string used by the app (dev)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/todo_app?schema=public"

# Separate database used only by the test suite (kept isolated from dev data)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/todo_app_test?schema=public"

# NextAuth / Auth.js
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"
